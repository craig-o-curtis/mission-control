SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

# ── App Database ───────────────────────────────────────────────────
# Comment out for SQLite (default). Uncomment one for Docker.
# DATABASE_URL=mysql+pymysql://root:12345678@localhost:3306/checklists_application_database
# DATABASE_URL=postgresql+psycopg://postgres:12345678@localhost:5432/ChecklistsApplicationDatabase

# ── Admin Seed User ───────────────────────────────────────────────
# Used when loggin into Swagger docs
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ── Test Database ─────────────────────────────────────────────────
# Comment out for SQLite in-memory. Uncomment to test against a real DB.
# TEST_DATABASE_URL=mysql+pymysql://root:12345678@localhost:3306/checklists_application_database_test
# TEST_DATABASE_URL=postgresql+psycopg://postgres:12345678@localhost:5432/ChecklistsApplicationDatabase_test

# ── Docker Compose: MySQL ─────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=checklists_application_database
MYSQL_PORT=3306
ADMINER_PORT=8080
# -- Testing MySQL
TEST_MYSQL_USER=root
TEST_MYSQL_PASSWORD=changeme
TEST_MYSQL_DB=checklists_application_database_test
TEST_MYSQL_HOST=localhost
TEST_MYSQL_PORT=3306


# ── Docker Compose: Postgres ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ChecklistsApplicationDatabase
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050
# -- Testing Postgres
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=changeme
TEST_POSTGRES_DB=ChecklistsApplicationDatabase_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432


